.vscode
target
mipsel-sony-psp
*.zip
dist
.pspjs-*.workflow.js
dist-3ds
web/games.generated.js
web/site
runtime-3ds/build
runtime-3ds/source/game_js.h
runtime-3ds/source/game_dcpak.h
runtime-3ds/*.3dsx
runtime-3ds/*.elf
runtime-3ds/*.map
framework/node_modules
# Framework game bundles are generated into runtime/src/game/ (unprefixed names);
# only the tracked raw low-level demos (raw-*.js) are kept under version control.
# Per-game .dcpak asset packs are likewise generated by `bun framework/build.ts`
# (subset from the committed framework/src/assets.dcstore) and not tracked.
runtime/src/game/*.js
!runtime/src/game/raw-*.js
runtime/src/game/*.dcpak
node_modules

.DS_Store

# GoldSrc/CS BSP maps: Valve/CS-copyright maps + WADs fetched at build time, and their
# derivative baked modules, are NOT committed (only the CC0 box.bsp fixture + its module).
assets/vendor/bsp/*.bsp
assets/vendor/bsp/*.wad
framework/src/assets-bsp-*.ts
!framework/src/assets-bsp-box.ts
# Copyrighted map dcpak blobs bake into the gitignored private store (box + gltf blobs
# go into the committed assets.dcstore); build.ts merges both before per-game subsetting.
framework/src/assets-private.dcstore
