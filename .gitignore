.vscode
target
mipsel-sony-psp
*.zip
dist
.pspjs-*.workflow.js
dist-3ds
web/games.generated.js
web/site
runtime-3ds/build
runtime-3ds/source/game_js.h
runtime-3ds/*.3dsx
runtime-3ds/*.elf
runtime-3ds/*.map
framework/node_modules
# Framework game bundles are generated into runtime/src/game/ (unprefixed names);
# only the tracked raw low-level demos (raw-*.js) are kept under version control.
runtime/src/game/*.js
!runtime/src/game/raw-*.js
node_modules

.DS_Store

# GoldSrc/CS BSP maps: Valve/CS-copyright maps + WADs fetched at build time, and their
# derivative baked modules, are NOT committed (only the CC0 box.bsp fixture + its module).
assets/vendor/bsp/*.bsp
assets/vendor/bsp/*.wad
framework/src/assets-bsp-*.ts
!framework/src/assets-bsp-box.ts
