<?xml version="1.0" encoding="utf-8"?>
<!-- DreamCart bottom screen: the game library (3DS-style touch menu).
     There is NO virtual gamepad here — the console's physical D-pad / ABXY
     buttons play the game on the top screen. The bottom screen is only for
     browsing and switching games (tap a title). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/dc_bg"
    android:paddingHorizontal="48dp"
    android:paddingVertical="22dp">

    <TextView
        android:id="@+id/brand"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/app_name"
        android:textColor="@color/dc_accent"
        android:textSize="26sp"
        android:textStyle="bold"
        android:gravity="center" />

    <TextView
        android:id="@+id/now_playing"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="@string/loading"
        android:textColor="@color/dc_fg"
        android:textSize="15sp"
        android:gravity="center" />

    <TextView
        android:id="@+id/hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:text="@string/hint"
        android:textColor="@color/dc_muted"
        android:textSize="12sp"
        android:gravity="center" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:scrollbars="vertical">

        <LinearLayout
            android:id="@+id/game_list"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
    </ScrollView>

    <TextView
        android:id="@+id/log"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/dc_muted"
        android:textSize="10sp"
        android:fontFamily="monospace"
        android:maxLines="2"
        android:ellipsize="end" />

</LinearLayout>
